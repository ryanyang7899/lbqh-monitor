# ===== 联并千行MaaS 多用户监控 —— .env 示例 =====
# 复制为 .env 并填写。敏感项（含密钥/账号口令）勿提交到 git。
#
# 多用户模式下，平台账号/密码由各用户在网页「配置管理」页自行填写（加密入库）；
# 下方 LBQH_* / API_TOKEN 仅为旧单用户迁移保留，运行时不会用于抓取。
# 必填项：MAAS_API_KEY

# Fernet 主密钥（base64，长度 44）。留空则首次运行自动生成 master.key（请离线备份）
# MASTER_KEY=

# 验证码识别模型 API（OpenAI 兼容）
MAAS_API_URL=https://maasapi.paratera.com/v1/chat/completions
MAAS_API_KEY=your_api_key
CAPTCHA_MODEL=Qwen3.5-35B-A3B

# 抓取间隔（秒），默认 1 小时
FETCH_INTERVAL=3600

# ---- 以下为旧单用户字段（仅迁移用，可保留默认） ----
LBQH_USER=your_account
LBQH_PASSWORD=your_password
LBQH_BASE_URL=https://lbqh.paratera.com
API_TOKEN=change_me

# SQLite 数据库路径（Docker 部署由 docker-compose 自动覆盖为 /app/data/balance.db）
DB_PATH=balance.db
